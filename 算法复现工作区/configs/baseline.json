{
  "data_root": "../公开数据集",
  "output_root": "outputs",
  "cache_root": "cache",
  "synthetic_prediction_ids": [0, 1],
  "checkpoint": "01_FaultSeg3D/预训练模型与预测示例/fseg-60.hdf5",
  "patch_size": 128,
  "stride": 64,
  "tensorflow_cpu_threads": 4,
  "thebe_demo_split": "val",
  "thebe_demo_section_start": 36,
  "thebe_demo_shape_raw": [128, 192, 128],
  "decision_threshold": 0.5,
  "policy": "configs/data_policy.json",
  "training": {
    "run_name": "faultseg_author_v1",
    "epochs": 100,
    "fixed_baseline_epoch": 60,
    "learning_rate": 0.0001,
    "adam_beta_1": 0.9,
    "adam_beta_2": 0.999,
    "adam_epsilon": 1e-7,
    "numpy_seed": 12345,
    "tensorflow_seed": 1234,
    "source_volumes_per_step": 1,
    "effective_batch_size": 2,
    "augmentation": "identity_and_model_axis0_flip",
    "loss": "binary_crossentropy",
    "initialization": "random",
    "precision": "float32",
    "shuffle_training": true,
    "shuffle_validation": true,
    "save_each_epoch": true,
    "learning_rate_schedule": null,
    "early_stopping": false
  }
}
